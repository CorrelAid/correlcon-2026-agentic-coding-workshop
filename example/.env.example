# Copy to .env and add your token:  cp .env.example .env
# .env is NOT committed (see .gitignore).

# OpenAI-compatible endpoint of the EU provider (default: IONOS, data centres in Germany)
LLM_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
LLM_API_KEY=

# Model for the coding agent (must match opencode.json)
LLM_MODEL_CODING=Qwen/Qwen3-Coder-Next
# Model for analyses in project code (e.g. categorisation)
LLM_MODEL_ANALYSIS=openai/gpt-oss-120b
