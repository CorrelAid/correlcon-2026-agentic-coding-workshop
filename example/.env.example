# Copy to .env and fill in the key:  cp .env.example .env
# .env is NOT committed (see .gitignore) and is blocked for the agent.
# One provider, one key: IONOS AI Model Hub, data centres in Germany.

IONOS_API_KEY=

# Coding agent (OpenCode, configured in opencode.json)
LLM_MODEL_CODING=Qwen/Qwen3-Coder-Next

# Analysis model used by the project code (src/project/llm.py) – same IONOS key.
# To use another EU provider later, change these three lines (no code change).
LLM_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
LLM_API_KEY=${IONOS_API_KEY}
LLM_MODEL_ANALYSIS=openai/gpt-oss-120b
