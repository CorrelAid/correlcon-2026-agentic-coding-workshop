# Copy to .env and fill in the keys:  cp .env.example .env
# .env is NOT committed (see .gitignore) and is blocked for the agent.

# --- Coding agent (OpenCode) – IONOS AI Model Hub, data centres in Germany ---
IONOS_API_KEY=
LLM_MODEL_CODING=Qwen/Qwen3-Coder-Next

# --- Topic model used by the project code (src/project/llm.py) – Scaleway, Paris ---
# Scaleway API keys have an Access Key (SCW…) and a Secret Key (UUID): only the SECRET KEY
# goes here. Optional: https://api.scaleway.ai/<project-id>/v1 to bill a specific project.
LLM_BASE_URL=https://api.scaleway.ai/v1
LLM_API_KEY=
LLM_MODEL_ANALYSIS=glm-5.3
