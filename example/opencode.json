{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "providers": {
    "ionos": {
      "name": "IONOS AI Model Hub (data centres in Germany)",
      "env": [
        "IONOS_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://openai.inference.de-txl.ionos.com/v1"
      },
      "models": {
        "Qwen/Qwen3-Coder-Next": {
          "name": "Qwen3 Coder Next 80B (IONOS, DE)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 256000,
            "output": 32000
          },
          "cost": {
            "input": 0.15,
            "output": 0.8
          }
        },
        "openai/gpt-oss-120b": {
          "name": "gpt-oss-120b (IONOS, DE)",
          "capabilities": {
            "tools": true
          },
          "cost": {
            "input": 0.15,
            "output": 0.65
          }
        },
        "Qwen/Qwen3.5-397B-A17B": {
          "name": "Qwen3.5 397B (IONOS, DE) – strongest, ~4x the price",
          "capabilities": {
            "tools": true
          },
          "cost": {
            "input": 0.6,
            "output": 3.6
          }
        }
      }
    }
  },
  "model": "ionos/Qwen/Qwen3-Coder-Next",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "ionos", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:data/raw/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:data/interim/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*data/raw*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*data/interim*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:* .env*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*/.env*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*printenv*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*API_KEY*", "effect": "deny" },
    { "action": "tool.use", "resource": "execute:*", "effect": "deny" },
    { "action": "tool.use", "resource": "websearch:*", "effect": "deny" }
  ],
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "uv run *", "effect": "allow" },
    { "action": "shell", "resource": "uv sync *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "ask" }
  ]
}
