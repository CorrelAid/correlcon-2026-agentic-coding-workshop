{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "ionos"
  ],
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "ionos": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IONOS AI Model Hub (data centres in Germany)",
      "options": {
        "baseURL": "https://openai.inference.de-txl.ionos.com/v1",
        "apiKey": "{env:IONOS_API_KEY}"
      },
      "models": {
        "Qwen/Qwen3-Coder-Next": {
          "name": "Qwen3 Coder Next 80B (IONOS, DE)",
          "tool_call": true,
          "limit": {
            "context": 256000,
            "output": 32000
          },
          "cost": {
            "input": 0.15,
            "output": 0.8
          }
        },
        "openai/gpt-oss-120b": {
          "name": "gpt-oss-120b (IONOS, DE)",
          "tool_call": true,
          "cost": {
            "input": 0.15,
            "output": 0.65
          }
        },
        "Qwen/Qwen3.5-397B-A17B": {
          "name": "Qwen3.5 397B (IONOS, DE) – strongest, ~4x the price",
          "tool_call": true,
          "cost": {
            "input": 0.6,
            "output": 3.6
          }
        },
        "Qwen/Qwen3.5-9B": {
          "name": "Qwen3.5 9B (IONOS, DE) – titles / helper tasks",
          "cost": {
            "input": 0.1,
            "output": 0.15
          }
        }
      }
    }
  },
  "model": "ionos/Qwen/Qwen3-Coder-Next",
  "small_model": "ionos/Qwen/Qwen3.5-9B",
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "allow",
      "data/raw/*": "deny",
      "data/interim/*": "deny"
    },
    "bash": {
      "*": "ask",
      "uv run *": "allow",
      "uv sync*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow"
    },
    "webfetch": "ask",
    "websearch": "deny"
  }
}
